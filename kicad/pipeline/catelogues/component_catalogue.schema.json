{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "progen-component-catalogue/v0.2",
  "title": "ProGenEDA Component Catalogue",
  "type": "object",
  "required": ["schema", "unit", "grid", "components"],
  "properties": {
    "schema": {
      "const": "progen-component-catalogue/v0.2"
    },
    "unit": {
      "const": "mm"
    },
    "grid": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "components": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["category", "body", "legal_rotations", "default_rotation", "pin_model"],
        "properties": {
          "aliases": {
            "type": "array",
            "items": {"type": "string"}
          },
          "category": {"type": "string"},
          "body": {
            "type": "object",
            "required": ["width", "height", "origin", "keepout"],
            "properties": {
              "width": {"type": "number", "exclusiveMinimum": 0},
              "height": {"type": "number", "exclusiveMinimum": 0},
              "origin": {"const": "center"},
              "keepout": {
                "type": "object",
                "required": ["left", "right", "top", "bottom"],
                "properties": {
                  "left": {"type": "number", "minimum": 0},
                  "right": {"type": "number", "minimum": 0},
                  "top": {"type": "number", "minimum": 0},
                  "bottom": {"type": "number", "minimum": 0}
                }
              }
            }
          },
          "legal_rotations": {
            "type": "array",
            "items": {"enum": [0, 90, 180, 270]},
            "minItems": 1
          },
          "default_rotation": {"enum": [0, 90, 180, 270]},
          "pin_model": {
            "type": "object",
            "required": ["coordinate_system", "pins"],
            "properties": {
              "coordinate_system": {"const": "local_center_origin"},
              "pins": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "required": ["number", "local", "side", "type", "roles"],
                  "properties": {
                    "number": {"type": "string"},
                    "local": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 2,
                      "items": {"type": "number"}
                    },
                    "side": {"enum": ["left", "right", "top", "bottom"]},
                    "type": {"type": "string"},
                    "roles": {
                      "type": "array",
                      "items": {"type": "string"}
                    }
                  }
                }
              }
            }
          },
          "routing_hints": {"type": "object"},
          "placement_hints": {"type": "object"}
        }
      }
    }
  }
}
