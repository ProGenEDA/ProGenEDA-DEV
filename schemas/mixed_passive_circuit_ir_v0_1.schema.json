{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/proteusgen/schemas/mixed_passive_circuit_ir_v0_1.schema.json",
  "title": "Proteus Mixed Passive CircuitIR v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generator_target", "project", "nodes", "components", "layout"],
  "properties": {
    "schema_version": {"const": "proteus-mixed-passive-ir/v0.1"},
    "generator_target": {"const": "proteus-8.13-mixed-passive-terminal-power-ground"},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "output_basename", "base", "units"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "output_basename": {"type": "string", "minLength": 1, "pattern": "^[^\\\\/:*?\"<>|]+$"},
        "base": {"const": "E001_EMPTY_BASE"},
        "units": {"const": "proteus_internal"}
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": {"type": "string", "pattern": "^[\\x20-\\x7e]{2}$"},
          "kind": {"type": "string", "enum": ["internal", "power", "ground"], "default": "internal"},
          "role": {"type": "string"}
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "type", "value", "nodes"],
        "properties": {
          "ref": {"type": "string", "pattern": "^[\\x20-\\x7e]{2}$"},
          "type": {"type": "string", "enum": ["RESISTOR", "CAPACITOR"]},
          "value": {"type": "string", "minLength": 1},
          "nodes": {
            "type": "array",
            "prefixItems": [
              {"type": "string", "pattern": "^[\\x20-\\x7e]{2}$"},
              {"type": "string", "pattern": "^[\\x20-\\x7e]{2}$"}
            ],
            "minItems": 2,
            "maxItems": 2
          },
          "visual": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "coordinate_units", "component_positions"],
      "properties": {
        "mode": {"type": "string", "enum": ["manual_component_positions", "branch_grid", "auto_grid"]},
        "coordinate_units": {"const": "proteus_internal"},
        "auto_place": {"type": "boolean", "default": false},
        "component_positions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y"],
            "properties": {
              "x": {"type": "integer"},
              "y": {"type": "integer"}
            }
          }
        },
        "visual_wires": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x1", "y1", "x2", "y2"],
            "properties": {
              "x1": {"type": "integer"},
              "y1": {"type": "integer"},
              "x2": {"type": "integer"},
              "y2": {"type": "integer"}
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
