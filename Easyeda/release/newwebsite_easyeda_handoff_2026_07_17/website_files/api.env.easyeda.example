# Donor-native EasyEDA Pro executable. The handoff installer uses this path.
PROGEN_EASYEDA_EXECUTABLE_PATH=vendor/easyeda/progen-easyeda
PROGEN_EASYEDA_WORK_DIR=local-data/easyeda-runs
PROGEN_EASYEDA_EXAMPLE_LIBRARY_DIR=vendor/easyeda/examples-300

# Prompt planning uses the existing server-only provider settings.
# Direct JSON and all 300 verified examples work with AI disabled.
PROGEN_AI_PROVIDER=disabled
PROGEN_OPENAI_API_KEY=
PROGEN_OPENAI_MODEL=gpt-5-mini
