{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/proteusgen/inductor_circuit_ir_v0_1.schema.json",
  "title": "ProteusGen Inductor CircuitIR v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generator_target", "project", "nodes", "components", "layout", "metadata"],
  "properties": {
    "schema_version": {"const": "proteus-inductor-ir/v0.1"},
    "generator_target": {"const": "proteus-8.13-inductor-terminal-power-ground"},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "output_basename", "base", "units"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "output_basename": {"type": "string", "minLength": 1, "pattern": "^[^\\\\/:*?\"<>|]+$"},
        "base": {"const": "E001_EMPTY_BASE"},
        "units": {"const": "proteus_internal"}
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind"],
        "properties": {
          "id": {"type": "string", "minLength": 2, "maxLength": 2},
          "kind": {"enum": ["internal", "power", "ground"]},
          "role": {"type": "string"}
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "type", "value", "nodes", "visual"],
        "properties": {
          "ref": {"type": "string", "minLength": 2, "maxLength": 2},
          "type": {"const": "INDUCTOR"},
          "value": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?[A-Za-z]{1,3}$"},
          "nodes": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {"type": "string", "minLength": 2, "maxLength": 2}
          },
          "visual": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "visible_value": {"type": "string", "minLength": 3, "maxLength": 4},
              "internal_power_node": {"type": "string", "minLength": 2, "maxLength": 2},
              "row": {"type": "integer"},
              "col": {"type": "integer"}
            }
          }
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "coordinate_units", "component_positions", "visual_wires", "auto_place"],
      "properties": {
        "mode": {"enum": ["manual_component_positions", "branch_grid", "auto_grid"]},
        "coordinate_units": {"const": "proteus_internal"},
        "component_positions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y"],
            "properties": {
              "x": {"type": "integer"},
              "y": {"type": "integer"}
            }
          }
        },
        "visual_wires": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x1", "y1", "x2", "y2"],
            "properties": {
              "x1": {"type": "integer"},
              "y1": {"type": "integer"},
              "x2": {"type": "integer"},
              "y2": {"type": "integer"}
            }
          }
        },
        "auto_place": {"type": "boolean"}
      }
    },
    "metadata": {"type": "object"}
  }
}
